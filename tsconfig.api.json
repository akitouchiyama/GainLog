{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsc/api",
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/api/**/*", "worker-configuration.d.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
